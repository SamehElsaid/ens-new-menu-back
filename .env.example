# Copy to `.env.development` or `.env.production` and fill in values.
# Never commit real secrets or Firebase service-account JSON files to git.

NODE_ENV=development
PORT=4021
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4021

# Database
DB_HOST=localhost
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=SaasMenu
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_KEY=

# Firebase Admin (push notifications) — use ONE of:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/outside/repo/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json

# Payment test routes (NEVER set true in production)
# ENABLE_PAYMENT_TEST_ROUTES=false

# EasyKash
EASYKASH_API_KEY=
EASYKASH_HMAC_SECRET=
EASYKASH_API_URL=https://back.easykash.net
EASYKASH_CALLBACK_URL=
EASYKASH_REDIRECT_URL=
EASYKASH_ENABLED=true
